{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compañero local configuration V2",
  "type": "object",
  "required": [
    "version",
    "settings",
    "tasks",
    "alarms",
    "events",
    "music"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 2
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "threshold",
        "autoVoice",
        "idle",
        "calendarRest"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "threshold": {
          "enum": [
            500,
            800,
            1200
          ]
        },
        "autoVoice": {
          "type": "boolean"
        },
        "idle": {
          "enum": [
            15,
            30,
            60,
            120
          ]
        },
        "calendarRest": {
          "type": "boolean"
        }
      }
    },
    "tasks": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "date",
          "done"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "date": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "format": "date"
              },
              {
                "const": ""
              }
            ]
          },
          "done": {
            "type": "boolean"
          }
        }
      }
    },
    "alarms": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "time",
          "days",
          "enabled"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "time": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "days": {
            "enum": [
              "Todos los días",
              "Lun a vie",
              "Fin de semana",
              "Una vez"
            ]
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    },
    "events": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "date",
          "time"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "format": "date"
          },
          "time": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "endTime": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "endDate": {
            "type": "string",
            "format": "date"
          },
          "allDay": {
            "type": "boolean"
          }
        }
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "artist",
        "duration",
        "position",
        "playing",
        "volume"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "artist": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "duration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7200
        },
        "position": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7200
        },
        "playing": {
          "type": "boolean"
        },
        "volume": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calendar",
        "music"
      ],
      "properties": {
        "calendar": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "connected",
            "email",
            "calendarId",
            "showOnDevice",
            "lastSync"
          ],
          "properties": {
            "connected": {
              "type": "boolean"
            },
            "email": {
              "type": "string",
              "maxLength": 120
            },
            "calendarId": {
              "enum": [
                "primary",
                "work",
                "personal"
              ]
            },
            "showOnDevice": {
              "type": "boolean"
            },
            "lastSync": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "format": "date-time"
                }
              ]
            }
          }
        },
        "music": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "target"
          ],
          "properties": {
            "provider": {
              "enum": [
                "demo",
                "spotify"
              ]
            },
            "target": {
              "type": "string",
              "maxLength": 60
            }
          }
        }
      }
    }
  },
  "$comment": "Runtime validation also enforces unique IDs per collection, real calendar dates, nonblank text and music.position <= music.duration. integrations is optional for existing V2 exports. No provider credentials."
}
